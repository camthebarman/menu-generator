# Copy to .env.local. Leave both Supabase values empty to run the local demo (no account needed).
# Browser-visible values only — never put a service-role key or Anthropic key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# false in production hides the local demo on the sign-in page.
VITE_ALLOW_DEMO=true
# Set to true only after deploying supabase/functions/ai-assist with ANTHROPIC_API_KEY as a function secret.
VITE_AI_ENABLED=false

# --- Server-side only (Supabase function secrets: `supabase secrets set ...`) ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_RATE_PER_HOUR=20
# ALLOWED_ORIGIN=https://your-app.example

# --- Tests ---
# PG_TEST_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres   # optional: run test:db against `supabase start`
# PW_CHROMIUM_PATH=/path/to/chromium                                    # optional: custom Playwright browser
